@model LowStockViewModel

@{
    ViewData["Title"] = "Low Stock Products";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Low Stock Products</h2>
            <p class="text-muted">Products that are below their configured threshold</p>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @if (Model.Products != null && Model.Products.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product Name</th>
                                        <th>Category</th>
                                        <th>Supplier</th>
                                        <th>Current Quantity</th>
                                        <th>Low Stock Threshold</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.Products)
                                    {
                                        <tr>
                                            <td class="fw-medium">@product.Name</td>
                                            <td>@product.CategoryName</td>
                                            <td>@product.SupplierName</td>
                                            <td>
                                                <span class="badge bg-danger">@product.Quantity</span>
                                            </td>
                                            <td>@product.LowStockThreshold</td>
                                            <td>
                                                <span class="badge bg-danger">Low Stock</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    @if (Model.Page > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="/Product/LowStock?page=1">First</a>
                                        </li>
                                        <li class="page-item">
                                            <a class="page-link" href="/Product/LowStock?page=@(Model.Page - 1)">Previous</a>
                                        </li>
                                    }

                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        @if (i >= Model.Page - 2 && i <= Model.Page + 2)
                                        {
                                            @if (i == Model.Page)
                                            {
                                                <li class="page-item active">
                                                    <span class="page-link">@i</span>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="/Product/LowStock?page=@i">@i</a>
                                                </li>
                                            }
                                        }
                                    }

                                    @if (Model.Page < Model.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="/Product/LowStock?page=@(Model.Page + 1)">Next</a>
                                        </li>
                                        <li class="page-item">
                                            <a class="page-link" href="/Product/LowStock?page=@Model.TotalPages">Last</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i>
                            <strong>Great!</strong> No products are currently below their low stock threshold.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
